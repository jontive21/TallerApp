# Archivos subidos por usuarios (NO deben estar en el repositorio)
TallerApp.Web/wwwroot/uploads/
TallerApp.Web/wwwroot/img/avatars/

# Archivos de configuración local con datos sensibles (opcional pero recomendado)
appsettings.Development.json
