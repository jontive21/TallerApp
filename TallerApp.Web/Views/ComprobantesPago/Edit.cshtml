@model TallerApp.Web.Models.ComprobantePagoViewModel

@{
    ViewData["Title"] = "Editar Comprobante de Pago";
}

<div class="container mt-4">
    <h1>Editar Comprobante de Pago</h1>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="IdComprobante" />
                <div class="form-group mb-3">
                    <label asp-for="OrdenId" class="control-label"></label>
                    <input asp-for="OrdenId" class="form-control" type="number" />
                    <span asp-validation-for="OrdenId" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Monto" class="control-label"></label>
                    <input asp-for="Monto" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Monto" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="FechaPago" class="control-label"></label>
                    <input asp-for="FechaPago" class="form-control" type="date" />
                    <span asp-validation-for="FechaPago" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Estado" class="control-label"></label>
                    <select asp-for="Estado" class="form-control">
                        <option value="Pendiente">Pendiente</option>
                        <option value="Pagado">Pagado</option>
                        <option value="Anulado">Anulado</option>
                    </select>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>
                @if (!string.IsNullOrEmpty(Model.ArchivoComprobante))
                {
                    <div class="form-group mb-3">
                        <label class="control-label">Archivo actual:</label>
                        <a href="@Model.ArchivoComprobante" target="_blank" class="btn btn-sm btn-outline-primary">Ver archivo actual</a>
                        <small class="form-text text-muted">Si subes un nuevo archivo, reemplazará al actual.</small>
                    </div>
                }
                <div class="form-group mb-3">
                    <label asp-for="Archivo" class="control-label">Nuevo archivo (opcional)</label>
                    <input asp-for="Archivo" class="form-control" type="file" accept=".pdf,.jpg,.jpeg,.png" />
                    <small class="form-text text-muted">Formatos: PDF, JPG, PNG. Máximo 5 MB.</small>
                    <span asp-validation-for="Archivo" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Guardar" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Volver</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}