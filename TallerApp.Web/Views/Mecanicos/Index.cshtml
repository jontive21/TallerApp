@model IEnumerable<TallerApp.Web.Models.Mecanico>

@{
    ViewData["Title"] = "Mecánicos";
    string busqueda = ViewBag.Busqueda ?? "";
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Mecánicos</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Mecánico
        </a>
    </div>

    <!-- Formulario de búsqueda -->
    <div class="card mb-3">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-2">
                <div class="col-md-8">
                    <input type="text" name="busqueda" value="@busqueda" class="form-control" placeholder="Buscar por nombre, matrícula o especialidad..." />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Buscar</button>
                </div>
                <div class="col-md-2">
                    <a asp-action="Index" class="btn btn-secondary w-100">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info">No se encontraron mecánicos.</div>
            }
            else
            {
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Nombre Completo</th>
                            <th>Matrícula</th>
                            <th>Especialidad</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.NombreCompleto</td>
                                <td>@item.Matricula</td>
                                <td>@item.Especialidad</td>
                                <td>@item.Email</td>
                                <td>@item.Telefono</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.IdMecanico" class="btn btn-sm btn-warning">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.IdMecanico" class="btn btn-sm btn-danger">Eliminar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- Controles de paginación -->
    @if (totalPaginas > 1)
    {
        <nav aria-label="Navegación de páginas" class="mt-3">
            <ul class="pagination justify-content-center">
                <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)" asp-route-busqueda="@busqueda">Anterior</a>
                </li>
                
                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == paginaActual ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-busqueda="@busqueda">@i</a>
                    </li>
                }
                
                <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)" asp-route-busqueda="@busqueda">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>