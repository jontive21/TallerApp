@model IEnumerable<TallerApp.Web.Models.Vehiculo>

@{
    ViewData["Title"] = "Vehículos";
    var clientes = ViewBag.Clientes as List<TallerApp.Web.Models.Cliente>;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Vehículos</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Vehículo
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Patente</th>
                        <th>Marca</th>
                        <th>Modelo</th>
                        <th>Año</th>
                        <th>Color</th>
                        <th>Cliente</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var cliente = clientes?.FirstOrDefault(c => c.IdCliente == item.ClienteId);
                        <tr>
                            <td>@item.Patente</td>
                            <td>@item.Marca</td>
                            <td>@item.Modelo</td>
                            <td>@item.Anio</td>
                            <td>@item.Color</td>
                            <td>@(cliente?.NombreCompleto ?? "N/A")</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.IdVehiculo" class="btn btn-sm btn-warning">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.IdVehiculo" class="btn btn-sm btn-danger">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
