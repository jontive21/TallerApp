@model IEnumerable<TallerApp.Web.Models.Repuesto>

@{
    ViewData["Title"] = "Repuestos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Repuestos</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Repuesto
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre</th>
                        <th>Código</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Foto</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Nombre</td>
                            <td>@item.Codigo</td>
                            <td>$@item.Precio.ToString("N2")</td>
                            <td>@item.Stock</td>
                            <td>@(string.IsNullOrEmpty(item.Foto) ? "Sin foto" : item.Foto)</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.IdRepuesto" class="btn btn-sm btn-warning">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.IdRepuesto" class="btn btn-sm btn-danger">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
