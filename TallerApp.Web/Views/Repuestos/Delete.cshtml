@model TallerApp.Web.Models.Repuesto

@{
    ViewData["Title"] = "Eliminar Repuesto";
}

<div class="container mt-4">
    <h1>Eliminar Repuesto</h1>
    <h3 class="text-danger">¿Está seguro que desea eliminar este repuesto?</h3>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>
        <dt class="col-sm-3">Código</dt>
        <dd class="col-sm-9">@Model.Codigo</dd>
        <dt class="col-sm-3">Precio</dt>
        <dd class="col-sm-9">$@Model.Precio.ToString("N2")</dd>
        <dt class="col-sm-3">Stock</dt>
        <dd class="col-sm-9">@Model.Stock</dd>
        <dt class="col-sm-3">Foto</dt>
        <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Foto) ? "Sin foto" : Model.Foto)</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="IdRepuesto" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </form>
</div>
