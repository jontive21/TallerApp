{
	"info": {
		"_postman_id": "tallerapp-api-jwt-collection",
		"name": "TallerApp API - JWT",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Login - Obtener Token JWT",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"admin@tallerapp.com\",\n  \"password\": \"Admin123\"\n}"
				},
				"url": {
					"raw": "http://localhost:5063/api/apiauth/login",
					"protocol": "http",
					"host": ["localhost"],
					"port": "5063",
					"path": ["api", "apiauth", "login"]
				}
			}
		},
		{
			"name": "2. Endpoint Protegido - Usar Token",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": {
					"raw": "http://localhost:5063/api/apiordenes/test",
					"protocol": "http",
					"host": ["localhost"],
					"port": "5063",
					"path": ["api", "apiordenes", "test"]
				}
			}
		}
	]
}